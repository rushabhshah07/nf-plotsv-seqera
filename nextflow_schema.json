{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nf-plotsv parameters",
  "description": "Parameters for nf-plotsv (minimap2 → SyRi → plotsr).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "samplesheet": {
      "title": "Samplesheet (CSV)",
      "type": "string",
      "description": "CSV with columns: name,fasta (local path or cloud URI)."
    },
    "pairwise": {
      "title": "Pairwise mode",
      "type": "boolean",
      "default": true,
      "description": "If true, compare each sample pairwise down the samplesheet and plot a single multi-genome figure."
    },
    "reference": {
      "title": "Reference label",
      "type": "string",
      "default": "Col-CEN_v1.2",
      "description": "Only used when pairwise=false."
    },
    "ref_genome": {
      "title": "Reference genome (FASTA)",
      "type": "string",
      "default": "$projectDir/assets/Col-CEN_v1.2.fasta",
      "description": "Only used when pairwise=false."
    },
    "reorient": {
      "title": "Reorient sequences",
      "type": "boolean",
      "default": false,
      "description": "Requires containerized run; not supported with -profile conda."
    },
    "subset_pattern": {
      "title": "Subset pattern",
      "type": "string",
      "default": "Chr[1-5]",
      "description": "Regex to subset chromosomes/contigs."
    },
    "out": {
      "title": "Output directory",
      "type": "string",
      "default": "./",
      "description": "Directory/URI where results will be written."
    },
    "plotsr_conf": {
      "title": "plotsr config",
      "type": "string",
      "default": "$projectDir/assets/plotsr_config.conf",
      "description": "Configuration file for plotsr."
    },
    "plotsr_args": {
      "title": "plotsr extra args",
      "type": "string",
      "default": "-S 0.7 -W 5 -H 5 -f 12",
      "description": "Extra CLI flags passed to plotsr."
    },
    "plotsr_tracks": {
      "title": "plotsr tracks",
      "type": "string",
      "default": "",
      "description": "Optional tracks file (absolute path or full URI)."
    },
    "plotsr_colors": {
      "title": "plotsr colors",
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional list of hex colors (e.g., #1f77b4)."
    }
  },
  "required": ["samplesheet"]
}