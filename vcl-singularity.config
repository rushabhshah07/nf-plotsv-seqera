/* Reuse the repo's Docker image mapping, but execute with Singularity */
includeConfig "$projectDir/configs/docker.config"

docker.enabled       = false
singularity.enabled  = true
singularity.autoMounts = true
// optional local cache to avoid re-pulling images every time
singularity.cacheDir = "$projectDir/.singularity-cache"

// (nice-to-have) consistent shell behavior
process.shell = ['/bin/bash','-euo','pipefail']
