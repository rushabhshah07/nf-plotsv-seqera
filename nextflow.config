profiles {
  docker       { includeConfig 'configs/docker.config' }
  charliecloud { includeConfig 'configs/charliecloud.config' }
  conda        { includeConfig 'configs/conda.config' }
  biohpc_gen   { includeConfig 'configs/biohpc_gen.config' }
  local        { executor.name = 'local' }

  // === Singularity only ===
  singularity {
    includeConfig 'configs/docker.config'    // reuse repo mapping

    docker.enabled          = false
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.pullTimeout = '45m'

    process {
      shell = ['/bin/bash','-euo','pipefail']

      // Make `ps` usable inside containers (binary + lib)
      // Most RHEL-like hosts: lib in /usr/lib64
      // (If your host is Debian/Ubuntu, add a similar bind for /usr/lib/x86_64-linux-gnu/libprocps.so.8)
      containerOptions = '--bind /usr/bin/ps:/usr/bin/ps --bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8'

      // Ensure SUBSET always has seqtk
      withName: 'PLOTSV:PREPARE_GENOMES:SUBSET*' {
        container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
      }

      // Be explicit for the SyRI/plotsr step (the image you’ve been using)
      withName: 'PLOTSV:SYRI_PAIRWISE*' {
        container = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
      }

      // Same container used by PLOTSR step; bind fixes `ps` for it too
      withName: 'PLOTSV:PLOTSR_PAIRWISE_OLD*' {
        container = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
      }
    }
  }
}

params {
  publish_dir_mode = 'copy'

  // safe defaults for the form
  samplesheet    = ''
  reference      = 'Col-CEN_v1.2'
  ref_genome     = "$projectDir/assets/Col-CEN_v1.2.fasta"
  pairwise       = true
  reorient       = false
  subset_pattern = "Chr[1-5]"

  plotsr_conf    = "$projectDir/assets/plotsr_config.conf"
  plotsr_args    = '-S 0.9 -W 7 -H 8 -f 12'
  plotsr_tracks  = ''

  // Give exactly 2 colors to match 2 genomes -> avoids buggy branch in the module
  plotsr_colors  = ['#F0A0FF', '#0075DC']

  out            = './'
}

/*
 * Auto-apply same settings on Seqera (when the UI doesn’t expose profiles)
 */
if( System.getenv('TOWER_WORKFLOW_ID') ) {
  includeConfig 'configs/docker.config'
  docker.enabled          = false
  singularity.enabled     = true
  singularity.autoMounts  = true
  singularity.pullTimeout = '45m'

  process {
    shell = ['/bin/bash','-euo','pipefail']
    containerOptions = '--bind /usr/bin/ps:/usr/bin/ps --bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8'

    withName: 'PLOTSV:PREPARE_GENOMES:SUBSET*' {
      container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
    }
    withName: 'PLOTSV:SYRI_PAIRWISE*' {
      container = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
    }
    withName: 'PLOTSV:PLOTSR_PAIRWISE_OLD*' {
      container = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
    }
  }
}

/* Trim common path params to avoid leading/trailing spaces */
params.out           = (params.out ?: './').trim()
params.samplesheet   = params.samplesheet?.trim()
params.ref_genome    = params.ref_genome?.trim()
params.plotsr_conf   = params.plotsr_conf?.trim()
params.plotsr_tracks = (params.plotsr_tracks ?: '').trim()