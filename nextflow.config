// ----- global extras (safe to reference anywhere) -----
ext {
  // Bind ps + libprocps for RHEL/CentOS-style hosts
  COMMON_BINDS = [
    '--bind /bin/ps:/bin/ps',
    '--bind /usr/bin/ps:/usr/bin/ps',
    '--bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8',
    '--bind /lib64/libprocps.so.8:/lib64/libprocps.so.8'
  ].join(' ')
}

profiles {
  docker       { includeConfig 'configs/docker.config' }
  charliecloud { includeConfig 'configs/charliecloud.config' }
  conda        { includeConfig 'configs/conda.config' }
  biohpc_gen   { includeConfig 'configs/biohpc_gen.config' }
  local        { executor.name = 'local' }

  // === Singularity / Apptainer ===
  singularity {
    includeConfig 'configs/docker.config'

    docker.enabled          = false
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.pullTimeout = '45m'

    process {
      shell = ['/bin/bash','-euo','pipefail']

      // SUBSET — seqtk image
      withName: /PLOTSV:PREPARE_GENOMES:SUBSET.*/ {
        container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
      }

      // SyRI — needs ps/libprocps; also set writable caches
      withName: /PLOTSV:SYRI_PAIRWISE.*/ {
        container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
        containerOptions = ext.COMMON_BINDS
        environment = [
          'OPENBLAS_NUM_THREADS': '1',
          'OMP_NUM_THREADS'     : '1',
          'MKL_NUM_THREADS'     : '1',
          'NUMEXPR_MAX_THREADS' : '1',
          'MPLCONFIGDIR'        : "$PWD/.mpl",
          'XDG_CACHE_HOME'      : "$PWD/.cache"
        ]
        cpus = 1
        errorStrategy = 'retry'
        maxRetries    = 1
      }

      // plotsr — same as SyRI
      withName: /PLOTSV:PLOTSR_PAIRWISE_OLD.*/ {
        container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
        containerOptions = ext.COMMON_BINDS
        environment = [
          'OPENBLAS_NUM_THREADS': '1',
          'OMP_NUM_THREADS'     : '1',
          'MKL_NUM_THREADS'     : '1',
          'NUMEXPR_MAX_THREADS' : '1',
          'MPLCONFIGDIR'        : "$PWD/.mpl",
          'XDG_CACHE_HOME'      : "$PWD/.cache"
        ]
        cpus = 1
        errorStrategy = 'retry'
        maxRetries    = 1
      }
    }
  }
}

params {
  publish_dir_mode = 'copy'

  // safe defaults
  samplesheet    = ''
  reference      = 'Col-CEN_v1.2'
  ref_genome     = "$projectDir/assets/Col-CEN_v1.2.fasta"
  pairwise       = true
  reorient       = false
  subset_pattern = '^chr([1-9]|1[0-6])$'

  plotsr_conf    = "$projectDir/assets/plotsr_config.conf"
  plotsr_args    = '-S 0.9 -W 7 -H 8 -f 12'
  plotsr_tracks  = ''

  // keep as LIST; main.nf will normalize it
  plotsr_colors  = ['#F0A0FF', '#0075DC']

  out            = './'
}

// -------- Safe coercions (no stringifying the palette) --------
def _trim(v){ v instanceof CharSequence ? v.toString().trim() : v }
params.out           = _trim(params.out ?: './')
params.samplesheet   = _trim(params.samplesheet)
params.ref_genome    = _trim(params.ref_genome)
params.plotsr_conf   = _trim(params.plotsr_conf)
params.plotsr_tracks = _trim(params.plotsr_tracks ?: '')

// ensure non-empty default list (still a List)
if( !params.plotsr_colors || (params.plotsr_colors instanceof List && params.plotsr_colors.isEmpty()) )
  params.plotsr_colors = ['#F0A0FF', '#0075DC']

// -------- Tower parity --------
if( System.getenv('TOWER_WORKFLOW_ID') ) {
  includeConfig 'configs/docker.config'
  docker.enabled          = false
  singularity.enabled     = true
  singularity.autoMounts  = true
  singularity.pullTimeout = '45m'

  process {
    shell = ['/bin/bash','-euo','pipefail']

    withName: /PLOTSV:PREPARE_GENOMES:SUBSET.*/ {
      container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
    }
    withName: /PLOTSV:SYRI_PAIRWISE.*/ {
      container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
      containerOptions = ext.COMMON_BINDS
      environment = [
        'OPENBLAS_NUM_THREADS': '1',
        'OMP_NUM_THREADS'     : '1',
        'MKL_NUM_THREADS'     : '1',
        'NUMEXPR_MAX_THREADS' : '1',
        'MPLCONFIGDIR'        : "$PWD/.mpl",
        'XDG_CACHE_HOME'      : "$PWD/.cache"
      ]
      cpus = 1
      errorStrategy = 'retry'
      maxRetries    = 1
    }
    withName: /PLOTSV:PLOTSR_PAIRWISE_OLD.*/ {
      container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
      containerOptions = ext.COMMON_BINDS
      environment = [
        'OPENBLAS_NUM_THREADS': '1',
        'OMP_NUM_THREADS'     : '1',
        'MKL_NUM_THREADS'     : '1',
        'NUMEXPR_MAX_THREADS' : '1',
        'MPLCONFIGDIR'        : "$PWD/.mpl",
        'XDG_CACHE_HOME'      : "$PWD/.cache"
      ]
      cpus = 1
      errorStrategy = 'retry'
      maxRetries    = 1
    }
  }
}