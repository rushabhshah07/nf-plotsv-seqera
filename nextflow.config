profiles {
  docker       { includeConfig 'configs/docker.config' }
  charliecloud { includeConfig 'configs/charliecloud.config' }
  conda        { includeConfig 'configs/conda.config' }
  biohpc_gen   { includeConfig 'configs/biohpc_gen.config' }
  local        { executor.name = 'local' }

  singularity {
    includeConfig 'configs/docker.config'   // reuse repo mapping
    docker.enabled          = false
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.pullTimeout = '45m'

    process {
      shell    = ['/bin/bash','-euo','pipefail']
      executor = 'slurm'

      // 0) DEFAULT container so nothing ever runs on the host by mistake
      //    (will be overridden below for specific steps)
      container = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'

      // 1) SUBSET — guarantee seqtk image (regex ALWAYS matches)
      withName: /.*PREPARE_GENOMES:SUBSET.*/ {
        container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
        // optional: turn off monitor here too
        environment = [ NXF_TASK_MONITOR: '0' ]
      }

      // 2) ALIGN — explicit mapping (minimap2+samtools)
      withName: /.*ALIGN_PAIRWISE.*/ {
        container = 'docker://quay.io/schandry_containers/minimap2-samtools:latest'
      }

      // 3) SyRI — keep Schandry image, ensure `ps` exists via bind (covers RHEL & Ubuntu)
      withName: /.*SYRI_PAIRWISE.*/ {
        container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
        containerOptions = '--bind /bin/ps:/bin/ps,/usr/bin/ps:/usr/bin/ps,/lib64:/lib64,/usr/lib64:/usr/lib64,/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu'
        environment = [
          OPENBLAS_NUM_THREADS: '1',
          OMP_NUM_THREADS     : '1',
          MKL_NUM_THREADS     : '1',
          NUMEXPR_MAX_THREADS : '1'
        ]
        cpus = 1
        errorStrategy = 'retry'
        maxRetries    = 1
      }

      // 4) plotsr — same `ps` fix
      withName: /.*PLOTSR_PAIRWISE_OLD.*/ {
        container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
        containerOptions = '--bind /bin/ps:/bin/ps,/usr/bin/ps:/usr/bin/ps,/lib64:/lib64,/usr/lib64:/usr/lib64,/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu'
        environment = [
          OPENBLAS_NUM_THREADS: '1',
          OMP_NUM_THREADS     : '1',
          MKL_NUM_THREADS     : '1',
          NUMEXPR_MAX_THREADS : '1'
        ]
        cpus = 1
        errorStrategy = 'retry'
        maxRetries    = 1
      }
    }
  }
}

params {
  publish_dir_mode = 'copy'
  samplesheet    = ''
  reference      = 'Col-CEN_v1.2'
  ref_genome     = "$projectDir/assets/Col-CEN_v1.2.fasta"
  pairwise       = true
  reorient       = false
  subset_pattern = "Chr[1-5]"
  plotsr_conf    = "$projectDir/assets/plotsr_config.conf"
  plotsr_args    = '-S 0.9 -W 7 -H 8 -f 12'
  plotsr_tracks  = ''
  plotsr_colors  = ['#F0A0FF', '#0075DC']   // coerced below
  out            = './'
}

/* Safe coercions */
def _t(v){ v instanceof CharSequence ? v.toString().trim() : v }
params.out           = _t(params.out ?: './')
params.samplesheet   = _t(params.samplesheet)
params.ref_genome    = _t(params.ref_genome)
params.plotsr_conf   = _t(params.plotsr_conf)
params.plotsr_tracks = _t(params.plotsr_tracks ?: '')

/* Palette: force non-empty and convert list → space-separated string */
if( !params.plotsr_colors || params.plotsr_colors == '[]' || (params.plotsr_colors instanceof List && params.plotsr_colors.isEmpty()) )
  params.plotsr_colors = ['#F0A0FF', '#0075DC']
if( params.plotsr_colors instanceof List )
  params.plotsr_colors = params.plotsr_colors.join(' ')
