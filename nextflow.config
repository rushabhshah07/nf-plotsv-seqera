profiles {
  docker       { includeConfig 'configs/docker.config' }
  charliecloud { includeConfig 'configs/charliecloud.config' }
  conda        { includeConfig 'configs/conda.config' }
  biohpc_gen   { includeConfig 'configs/biohpc_gen.config' }
  local        { executor.name = 'local' }

  // === Singularity only ===
  singularity {
    includeConfig 'configs/docker.config'   // reuse repo mapping

    docker.enabled          = false
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.pullTimeout = '45m'

    process {
      shell = ['/bin/bash','-euo','pipefail']

      // SUBSET — ensure seqtk image (regex matches "(genomeX)" suffixes)
      withName: /PLOTSV:PREPARE_GENOMES:SUBSET.*/ {
        container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
      }

      // SyRI — container lacks ps; bind only ps + its lib; limit threads
      withName: /PLOTSV:SYRI_PAIRWISE.*/ {
        container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
        // RHEL/CentOS paths; if Debian/Ubuntu, see note below
        containerOptions = '--bind /usr/bin/ps:/bin/ps --bind /usr/bin/ps:/usr/bin/ps --bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8 --bind /lib64/libprocps.so.8:/lib64/libprocps.so.8'
        environment = [
          'OPENBLAS_NUM_THREADS': '1',
          'OMP_NUM_THREADS'     : '1',
          'MKL_NUM_THREADS'     : '1',
          'NUMEXPR_MAX_THREADS' : '1'
        ]
        cpus = 1
        errorStrategy = 'retry'
        maxRetries    = 1
      }

      // plotsr — same fix as SyRI
      withName: /PLOTSV:PLOTSR_PAIRWISE_OLD.*/ {
        container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
        containerOptions = '--bind /usr/bin/ps:/bin/ps --bind /usr/bin/ps:/usr/bin/ps --bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8 --bind /lib64/libprocps.so.8:/lib64/libprocps.so.8'
        environment = [
          'OPENBLAS_NUM_THREADS': '1',
          'OMP_NUM_THREADS'     : '1',
          'MKL_NUM_THREADS'     : '1',
          'NUMEXPR_MAX_THREADS' : '1'
        ]
        cpus = 1
        errorStrategy = 'retry'
        maxRetries    = 1
      }
    }
  }
}

params {
  publish_dir_mode = 'copy'

  // safe defaults
  samplesheet    = ''
  reference      = 'Col-CEN_v1.2'
  ref_genome     = "$projectDir/assets/Col-CEN_v1.2.fasta"
  pairwise       = true
  reorient       = false
  subset_pattern = "Chr[1-5]"

  plotsr_conf    = "$projectDir/assets/plotsr_config.conf"
  plotsr_args    = '-S 0.9 -W 7 -H 8 -f 12'
  plotsr_tracks  = ''

  // Default palette; coerced below to the string bash expects
  plotsr_colors  = ['#F0A0FF', '#0075DC']

  out            = './'
}

/* -------- Safe coercions (avoid .trim() on non-strings) -------- */
def _trim(v){ v instanceof CharSequence ? v.toString().trim() : v }
params.out           = _trim(params.out ?: './')
params.samplesheet   = _trim(params.samplesheet)
params.ref_genome    = _trim(params.ref_genome)
params.plotsr_conf   = _trim(params.plotsr_conf)
params.plotsr_tracks = _trim(params.plotsr_tracks ?: '')

// If Launchpad supplies null/[] or a list, convert to a non-empty space-separated string
if( !params.plotsr_colors || params.plotsr_colors == '[]' || (params.plotsr_colors instanceof List && params.plotsr_colors.isEmpty()) )
  params.plotsr_colors = ['#F0A0FF', '#0075DC']
if( params.plotsr_colors instanceof List )
  params.plotsr_colors = params.plotsr_colors.join(' ')

/* -------- Optional: same behavior when launched from Seqera without profile picker -------- */
if( System.getenv('TOWER_WORKFLOW_ID') ) {
  includeConfig 'configs/docker.config'
  docker.enabled          = false
  singularity.enabled     = true
  singularity.autoMounts  = true
  singularity.pullTimeout = '45m'

  process {
    shell = ['/bin/bash','-euo','pipefail']

    withName: /PLOTSV:PREPARE_GENOMES:SUBSET.*/ {
      container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
    }
    withName: /PLOTSV:SYRI_PAIRWISE.*/ {
      container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
      containerOptions = '--bind /usr/bin/ps:/bin/ps --bind /usr/bin/ps:/usr/bin/ps --bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8 --bind /lib64/libprocps.so.8:/lib64/libprocps.so.8'
      environment = [
        'OPENBLAS_NUM_THREADS': '1',
        'OMP_NUM_THREADS'     : '1',
        'MKL_NUM_THREADS'     : '1',
        'NUMEXPR_MAX_THREADS' : '1'
      ]
      cpus = 1
      errorStrategy = 'retry'
      maxRetries    = 1
    }
    withName: /PLOTSV:PLOTSR_PAIRWISE_OLD.*/ {
      container        = 'docker://quay.io/schandry_containers/fixchr-syri-plotsr:latest'
      containerOptions = '--bind /usr/bin/ps:/bin/ps --bind /usr/bin/ps:/usr/bin/ps --bind /usr/lib64/libprocps.so.8:/usr/lib64/libprocps.so.8 --bind /lib64/libprocps.so.8:/lib64/libprocps.so.8'
      environment = [
        'OPENBLAS_NUM_THREADS': '1',
        'OMP_NUM_THREADS'     : '1',
        'MKL_NUM_THREADS'     : '1',
        'NUMEXPR_MAX_THREADS' : '1'
      ]
      cpus = 1
      errorStrategy = 'retry'
      maxRetries    = 1
    }
  }
}