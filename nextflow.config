profiles {
    docker       { includeConfig 'configs/docker.config'        }
    charliecloud { includeConfig 'configs/charliecloud.config' }
    conda        { includeConfig 'configs/conda.config'        }
    biohpc_gen   { includeConfig 'configs/biohpc_gen.config'   }
    local        { executor.name = 'local' }

    // Option B: run Docker images via Singularity/Apptainer (HPC)
    singularity {
        // reuse the repo's container mapping
        includeConfig 'configs/docker.config'

        docker.enabled          = false
        singularity.enabled     = true
        singularity.autoMounts  = true
        fusion.enabled          = true            // keep if data is on S3/GS/Azure
        process.shell           = ['/bin/bash','-euo','pipefail']
        singularity.pullTimeout = '45m'

        // Ensure seqtk is present for SUBSET regardless of mapping
        process {
            withName: 'PLOTSV:PREPARE_GENOMES:SUBSET*' {
                container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_1'
            }
        }
    }
}

params {
    publish_dir_mode = 'copy'

    // clean & safe defaults
    samplesheet    = ''                                   // was: false
    reference      = 'Col-CEN_v1.2'
    ref_genome     = "$projectDir/assets/Col-CEN_v1.2.fasta"  // expand $projectDir
    pairwise       = true
    reorient       = false
    subset_pattern = "Chr[1-5]"

    plotsr_conf    = "$projectDir/assets/plotsr_config.conf"
    plotsr_args    = '-S 0.9 -W 7 -H 8 -f 12'
    plotsr_tracks  = ''            // non-null
    plotsr_colors  = []            // non-null list → avoids `val palette` null errors
    out            = './'
}